<odoo>
    <record id="view_stock_reservation_audit_search" model="ir.ui.view">
        <field name="name">stock.reservation.audit.search</field>
        <field name="model">stock.reservation.audit</field>
        <field name="arch" type="xml">
            <search string="Reservation Audit History">
                <field name="product_id"/>
                <field name="picking_id"/>
                <field name="move_id"/>
                <field name="user_id"/>
                <field name="reason"/>
                <filter name="unreserve" string="Unreserve" domain="[('action_type', 'in', ['unreserve', 'bulk_unreserve'])]"/>
                <filter name="reallocate" string="Reallocate" domain="[('action_type', '=', 'reallocate')]"/>
                <filter name="check_availability" string="Check Availability" domain="[('action_type', '=', 'check_availability')]"/>
                <separator/>
                <filter name="group_action" string="Action" context="{'group_by': 'action_type'}"/>
                <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                <filter name="group_date" string="Date" context="{'group_by': 'date:day'}"/>
            </search>
        </field>
    </record>

    <record id="view_stock_reservation_audit_list" model="ir.ui.view">
        <field name="name">stock.reservation.audit.list</field>
        <field name="model">stock.reservation.audit</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-info="action_type == 'check_availability'"
                  decoration-warning="action_type in ('unreserve', 'bulk_unreserve')"
                  decoration-success="action_type == 'reallocate'">
                <field name="date"/>
                <field name="user_id"/>
                <field name="action_type"/>
                <field name="product_id"/>
                <field name="picking_id"/>
                <field name="source_document_reference"/>
                <field name="quantity_before"/>
                <field name="quantity_changed"/>
                <field name="quantity_after"/>
                <field name="reason"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_stock_reservation_audit_form" model="ir.ui.view">
        <field name="name">stock.reservation.audit.form</field>
        <field name="model">stock.reservation.audit</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group string="Operation">
                            <field name="date"/>
                            <field name="user_id"/>
                            <field name="company_id"/>
                            <field name="action_type"/>
                        </group>
                        <group string="Reservation">
                            <field name="product_id"/>
                            <field name="picking_id"/>
                            <field name="move_id"/>
                            <field name="target_move_id" invisible="action_type != 'reallocate'"/>
                        </group>
                    </group>
                    <group string="Source Document">
                        <field name="source_document_reference"/>
                        <field name="source_document_model" invisible="1"/>
                        <field name="source_document_id" invisible="1"/>
                    </group>
                    <group string="Quantities">
                        <field name="quantity_before"/>
                        <field name="quantity_changed"/>
                        <field name="quantity_after"/>
                    </group>
                    <group string="Reason and Result">
                        <field name="reason"/>
                        <field name="notes"/>
                        <field name="result_notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_stock_reservation_audit" model="ir.actions.act_window">
        <field name="name">Reservation Audit History</field>
        <field name="res_model">stock.reservation.audit</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_stock_reservation_audit_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No manual reservation actions yet</p>
            <p>Audit entries are created automatically when an Inventory Manager checks availability, releases, or reallocates a reservation from the Reservation Manager.</p>
        </field>
    </record>
</odoo>
