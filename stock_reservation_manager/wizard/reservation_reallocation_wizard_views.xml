<odoo>
    <record id="view_reservation_reallocation_wizard_form" model="ir.ui.view">
        <field name="name">reservation.reallocation.wizard.form</field>
        <field name="model">stock.reservation.reallocation.wizard</field>
        <field name="arch" type="xml">
            <form string="Reservation Reallocation">
                <group>
                    <field name="source_line_ids" widget="many2many_tags" readonly="1"/>
                    <field name="source_product_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="reason_required" invisible="1"/>
                    <field name="target_move_id" domain="[('product_id', '=', source_product_id), ('company_id', '=', company_id), ('state', 'in', ['confirmed','waiting','partially_available','assigned'])]"/>
                    <field name="quantity_to_release"/>
                    <field name="reason" required="reason_required"/>
                    <field name="notes"/>
                    <field name="preview_data" widget="json" readonly="1"/>
                    <field name="snapshot" invisible="1"/>
                </group>
                <div class="alert alert-warning" role="alert">Expected results are advisory. Odoo removal rules determine the actual target reservation.</div>
                <footer>
                    <button name="action_preview" type="object" string="Preview Impact"/>
                    <button name="action_confirm" type="object" string="Confirm Reallocation" class="btn-primary" invisible="not preview_data"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
